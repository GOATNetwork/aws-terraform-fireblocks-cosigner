# AWS Region
aws_region = "us-west-1"

# AMI Configuration - Dynamic Ubuntu 24.04
ami_name_pattern = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"
ami_owner = "099720109477"

# VPC and Subnet Configuration
vpc_id = "vpc-xxxxxxxxx"
subnet_id = "subnet-xxxxxxxxx"

# EC2 Key Pair Configuration
key_name = "rpc-prod"

# Goat EBS Volume Configuration
goat_volume_size = 400
goat_snapshot_id = "snap-xxxxxxxxx"

# Geth EBS Volume Configuration
geth_volume_size = 200
geth_snapshot_id = "snap-xxxxxxxxx"